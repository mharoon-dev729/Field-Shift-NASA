# =============================================================================
# Field Shift - environment variable template
# Copy to `.env` (backend) and fill in locally. NEVER commit `.env`.
# Names only below: no real values belong in this file.
# =============================================================================

# ---- Runtime ----
NODE_ENV=development
API_PORT=8000
# Exact browser origins allowed to call the API (comma separated, no wildcards)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Supabase (server-side only) ----
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# anon/public key - safe for the browser ONLY if RLS is enabled
SUPABASE_ANON_KEY=
# service_role key - SERVER ONLY. Never expose to Vite/browser bundles.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string for migrations
SUPABASE_DB_URL=

# ---- NASA Earthdata (optional; only needed for granule download) ----
# Free account: https://urs.earthdata.nasa.gov/users/new
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ---- Data source toggles (see docs/DATA_SOURCE_REGISTER.md) ----
# NASA POWER needs no key. Set to "false" to force offline/test mode.
DATA_SOURCE_POWER_ENABLED=true
DATA_SOURCE_GIBS_ENABLED=true
DATA_SOURCE_CMR_ENABLED=true
DATA_SOURCE_SOILGRIDS_ENABLED=true
# Never serve synthetic fixtures as real observations
ALLOW_SYNTHETIC_FIXTURES=false
